// Source-of-truth note:
// Shopify owns Product, ProductVariant, Inventory, Order. This DB stores
// configuration the app needs to author and re-author variants, plus a thin
// mapping table so we can find our records by Shopify GIDs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Per-shop defaults. Created lazily on first visit to /app.
model ShopSettings {
  id              String   @id @default(cuid())
  shop            String   @unique
  defaultTimezone String   @default("America/New_York")
  defaultDurationMin Int   @default(60)
  defaultCapacity Int      @default(12)
  defaultLocationId String?
  defaultLocation Location? @relation(fields: [defaultLocationId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// A physical or virtual venue. Independent of Shopify Location (inventory) —
// this captures the human-facing address that ends up on the product/variant.
model Location {
  id          String   @id @default(cuid())
  shop        String
  name        String
  addressLine1 String?
  addressLine2 String?
  city        String?
  region      String?
  postalCode  String?
  country     String?
  timezone    String   @default("America/New_York")
  bookingNotificationEmails String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classProducts   ClassProduct[]
  shopSettings    ShopSettings[]

  @@index([shop])
}

// Marks a Shopify product as a "class" and stores the defaults used when
// authoring new variant-sessions for it.
model ClassProduct {
  id            String   @id @default(cuid())
  shop          String
  productGid    String   // gid://shopify/Product/...
  title         String
  status        String   @default("draft") // draft | active | archived (mirrors Shopify status loosely)
  locationId    String?
  location      Location? @relation(fields: [locationId], references: [id])
  timezone      String   @default("America/New_York")
  durationMin   Int      @default(60)
  defaultCapacity Int    @default(12)
  defaultPriceCents Int?
  notes         String?
  tags          String?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      ClassSession[]

  @@unique([shop, productGid])
  @@index([shop])
}

// One scheduled class date that maps 1:1 to a Shopify product variant.
// We persist the raw start/end + the variant GID so we can render the bookings
// view without paying for an Admin API call per row.
model ClassSession {
  id              String   @id @default(cuid())
  classProductId  String
  classProduct    ClassProduct @relation(fields: [classProductId], references: [id], onDelete: Cascade)
  shop            String
  variantGid      String   // gid://shopify/ProductVariant/...
  inventoryItemGid String?
  sku             String
  startsAt        DateTime
  endsAt          DateTime
  timezone        String
  capacity        Int
  priceCents      Int?
  cancelled       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, variantGid])
  @@index([classProductId, startsAt])
  @@index([shop, startsAt])
}
